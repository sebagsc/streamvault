# ============================================
# StreamVault - Frontend Environment Variables
# VERSION GRATUITA - Sin WebSockets
# ============================================
#
# Copia este archivo a .env.production para build de produccion
# o .env.local para desarrollo local
#
# NOTA: En la version gratuita NO se usa VITE_WS_URL
# El chat y presencia funcionan via polling HTTP
#
# ============================================

# URL de la API del Worker (produccion)
# Reemplaza con tu Worker URL real despues del deploy
VITE_API_URL=https://iptv-api.tu-subdomain.workers.dev/api

# NOTA: VITE_WS_URL no es necesario en la version gratuita
# Los WebSockets se reemplazaron por polling HTTP

# ============================================
# PARA DESARROLLO LOCAL
# ============================================
# Crea .env.local con:
# VITE_API_URL=/api
#
# El proxy de Vite redirigira /api al Worker local (localhost:8787)
